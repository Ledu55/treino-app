rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Backup de cada pessoa: users/{uid}. Só a própria pessoa lê e grava.
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Todo o resto é negado.
  }
}
