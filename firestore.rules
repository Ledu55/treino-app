rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    // Personais autorizados pelo aluno: { trainerUid: true } no documento do aluno
    function trainersOf(uid) {
      return get(/databases/$(database)/documents/users/$(uid)).data.get('trainers', {});
    }

    // Personal autorizado pelo aluno: listado em trainers no documento do aluno, que só o
    // próprio aluno grava. Remover da lista corta o acesso na hora.
    function isTrainerOf(uid) {
      return signedIn() && trainersOf(uid).get(request.auth.uid, false) == true;
    }

    // O personal sai da lista de um aluno (remover aluno, excluir a conta): tira só a si mesmo de
    // trainers e trainerNames, sem mexer em mais nada
    function removesOnlySelf() {
      let me = request.auth.uid;
      let before = resource.data;
      let after = request.resource.data;
      return after.diff(before).affectedKeys().hasOnly(['trainers', 'trainerNames'])
        && after.get('trainers', {}).diff(before.get('trainers', {})).affectedKeys().hasOnly([me])
        && !(me in after.get('trainers', {}))
        && after.get('trainerNames', {}).diff(before.get('trainerNames', {})).affectedKeys().hasOnly([me])
        && !(me in after.get('trainerNames', {}));
    }

    // Ficha montada por um personal que ainda tem acesso: a estrutura é só leitura para o aluno
    function lockedByTrainer(uid) {
      return resource.data.get('createdBy', null) is string
        && trainersOf(uid).get(resource.data.createdBy, false) == true;
    }

    // Ficha gravada pelo personal em nome próprio (e não apagada)
    function signedByTrainer() {
      let data = request.resource.data;
      return data.get('createdBy', null) == request.auth.uid
        && data.get('updatedBy', null) == request.auth.uid
        && data.get('deleted', false) != true;
    }

    // Perfil do aluno. O personal lê (inclusive pela consulta where('trainers.<uid>', '==', true),
    // que lista os alunos dele), mas só o aluno grava o perfil e a lista de personais.
    match /users/{uid} {
      allow read: if isOwner(uid)
        || (signedIn() && resource.data.get('trainers', {}).get(request.auth.uid, false) == true);
      allow write: if isOwner(uid);
      allow update: if signedIn() && resource.data.get('trainers', {}).get(request.auth.uid, false) == true
        && removesOnlySelf();

      // Fichas. O aluno faz tudo nas próprias; numa ficha do personal, só a apaga (deleted). O
      // personal cria fichas e edita só as que ele criou, sem apagar nenhuma.
      match /plans/{planId} {
        allow read: if isOwner(uid) || isTrainerOf(uid);
        allow create, delete: if isOwner(uid);
        allow update: if isOwner(uid)
          && (!lockedByTrainer(uid)
            || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['deleted', 'updatedAt', 'syncedAt']));
        allow create: if isTrainerOf(uid) && signedByTrainer();
        allow update: if isTrainerOf(uid) && signedByTrainer()
          && resource.data.get('createdBy', null) == request.auth.uid
          && resource.data.get('deleted', false) != true;
      }

      // Treinos finalizados: o personal só lê
      match /sessions/{sessionId} {
        allow read: if isOwner(uid) || isTrainerOf(uid);
        allow write: if isOwner(uid);
      }

      // Últimos valores digitados: só o aluno
      match /state/{docId} {
        allow read, write: if isOwner(uid);
      }
    }

    // Convite de personal. Quem tem o código lê o convite enquanto ele vale (não dá para listar
    // os convites dos outros); o personal cria, lista e apaga os dele. O vínculo em si é gravado
    // pelo aluno, no próprio documento.
    match /invites/{code} {
      allow get: if signedIn()
        && (resource.data.trainerUid == request.auth.uid || resource.data.expiresAt > request.time);
      allow list: if signedIn() && resource.data.trainerUid == request.auth.uid;
      allow create: if signedIn()
        && code.matches('^[A-HJ-NP-Z2-9]{6}$')
        && request.resource.data.keys().hasOnly(['trainerUid', 'trainerNome', 'expiresAt', 'createdAt'])
        && request.resource.data.trainerUid == request.auth.uid
        && request.resource.data.trainerNome is string
        && request.resource.data.trainerNome.size() <= 80
        && request.resource.data.expiresAt is timestamp
        && request.resource.data.expiresAt <= request.time + duration.value(8, 'd');
      allow delete: if signedIn() && resource.data.trainerUid == request.auth.uid;
    }

    // Todo o resto é negado.
  }
}
