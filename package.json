{
  "name": "meu-treino",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "emulators": "firebase emulators:start --project demo-treino",
    "test": "firebase emulators:exec --project demo-treino --only auth,firestore \"npm run test:unit && npm run test:rules && npm run test:e2e\"",
    "test:unit": "vitest run tests/unit",
    "test:rules": "vitest run tests/rules",
    "test:e2e": "playwright test",
    "deploy:rules:dev": "firebase deploy --only firestore:rules --project dev",
    "deploy:rules:prod": "firebase deploy --only firestore:rules --project prod"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "@playwright/test": "^1.63.0",
    "@preact/preset-vite": "^2.10.6",
    "firebase-tools": "^15.32.1",
    "jsdom": "^30.1.2",
    "vite": "^8.3.3",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.3",
    "workbox-core": "^7.4.1",
    "workbox-precaching": "^7.4.1",
    "workbox-window": "^7.4.1"
  },
  "dependencies": {
    "firebase": "^12.19.0",
    "preact": "^11.0.0"
  }
}
